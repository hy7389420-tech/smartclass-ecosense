ACTIVITY_INACTIVITY_WEIGHT=0.20
ACTIVITY_HEAD_WEIGHT=0.20
ACTIVITY_VOICE_WEIGHT=0.20
ACTIVITY_AUDIO_WEIGHT=0.10
ACTIVITY_MIN_SIGNALS=2
ACTIVITY_LOW_CUTOFF=0.35
ACTIVITY_HIGH_CUTOFF=0.65
ACTIVITY_LOW_RUN_WINDOWS=3
ACTIVITY_PEAK_COUNT=3
ACTIVITY_DECLINE_LAST_WINDOWS=3
ACTIVITY_DECLINE_MIN_WINDOWS=6
ACTIVITY_DECLINE_THRESHOLD=0.20
ACTIVITY_VOICE_LOW_THRESHOLD=0.20
ACTIVITY_VOICE_MIN_WINDOWS=3
ACTIVITY_MOVEMENT_SPIKE_THRESHOLD=0.60
ACTIVITY_NOISE_THRESHOLD_DBFS=-35
