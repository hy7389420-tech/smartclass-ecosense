CAMERA_OFFLINE_SECONDS=120
LOW_CONFIDENCE_ALERT_WINDOW_MINUTES=5
LOW_CONFIDENCE_ALERT_MIN_EVENTS=3
UNUSUAL_EXIT_ALERT_WINDOW_MINUTES=5
UNUSUAL_EXIT_ALERT_MIN_EVENTS=3
UNDERUTILIZED_CUTOFF_PERCENT=40
OVERUTILIZED_CUTOFF_PERCENT=90
INSIGHT_WINDOW_MINUTES=5
INSIGHT_MIN_EXITS=3
INSIGHT_MIN_BUCKETS=3
INSIGHT_MIN_HISTORY=3
INSIGHT_HISTORY_LECTURES=5
ACTIVITY_MAX_BATCH_SIZE=100
ACTIVITY_MIN_WINDOW_SECONDS=1
ACTIVITY_MAX_WINDOW_SECONDS=300
ACTIVITY_MOVEMENT_MIN=0
ACTIVITY_MOVEMENT_MAX=1
ACTIVITY_FRONT_MIN=0
ACTIVITY_FRONT_MAX=1
ACTIVITY_VOICE_MIN=0
ACTIVITY_VOICE_MAX=1
ACTIVITY_AUDIO_MIN_DBFS=-120
ACTIVITY_AUDIO_MAX_DBFS=0
